[
  {
    "name": "Gaman",
    "image": "cards/1-gaman.webp",
    "meaning": "<table>\n  <tr>\n    <th>Aspect</th>\n    <th>Description</th>\n  </tr>\n  <tr>\n    <td>Insight</td>\n    <td>Strength is not always movement. Sometimes it is the wisdom to wait.</td>\n  </tr>\n  <tr>\n    <td>Archetypal Energy</td>\n    <td>The Stoic, The Endurer, The Mountain. Resilience through stillness.</td>\n  </tr>\n  <tr>\n    <td>Emotional Tone</td>\n    <td>Calm, steady, composed. A low hum of strength beneath the storm.</td>\n  </tr>\n  <tr>\n    <td>Virtue Expression</td>\n    <td>Perseverance, patience, restraint, humility, quiet resilience.</td>\n  </tr>\n  <tr>\n    <td>Shadow Aspect</td>\n    <td>Repression, self-neglect, martyrdom, silent suffering, rigidity.</td>\n  </tr>\n  <tr>\n    <td>Psychological Function</td>\n    <td>Teaches emotional regulation, patience, and self-mastery; transforms reactive impulse into calm endurance.</td>\n  </tr>\n  <tr>\n    <td>Cultural Misuse</td>\n    <td>When used to enforce silence or conformity instead of dignified patience.</td>\n  </tr>\n  <tr>\n    <td>Reflection Questions</td>\n    <td>How can I persist without suppressing myself? Where does patience serve me and where does it wound me?</td>\n  </tr>\n  <tr>\n    <td>Message Summary</td>\n    <td>Endure with dignity, not denial. Let patience reveal your quiet power.</td>\n  </tr>\n  <tr>\n    <td>Mantra</td>\n    <td>“I bend but do not break. I endure with grace.”</td>\n  </tr>\n</table>"
  },
